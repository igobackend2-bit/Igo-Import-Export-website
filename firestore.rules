rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function myEmail() {
      return isAuthenticated() ? request.auth.token.email : null;
    }

    // True only if the caller's own /users/{uid} doc has role == 'admin'.
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users Collection
    match /users/{userId} {
      // Sellers' active/inactive status is looked up by other sellers and by
      // the admin dashboard, so authenticated users may read seller profiles.
      // Buyer/admin profiles remain visible only to their owner or an admin.
      allow read: if isOwner(userId) || isAdmin() ||
                    (isAuthenticated() && resource.data.role == 'seller');
      // Users can create their own profile at signup but cannot self-assign admin.
      allow create: if isOwner(userId) && request.resource.data.role in ['buyer', 'seller'];
      // Users can update their own profile but never change their own role;
      // only an admin can change a role or another user's account state.
      allow update: if isAdmin() ||
                      (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Products Collection
    match /products/{productId} {
      // Public catalog only shows approved products; sellers can see their own
      // pending/rejected listings; admins can see everything.
      allow read: if resource.data.status == 'approved' || isAdmin() ||
                    (isAuthenticated() && resource.data.sellerEmail == myEmail());
      // A seller may only create a listing under their own email, starting as pending.
      allow create: if isAuthenticated() &&
                      request.resource.data.sellerEmail == myEmail() &&
                      request.resource.data.status == 'pending';
      // A seller may edit their own pending listing (but not approve themselves);
      // an admin may change status/anything.
      allow update: if isAdmin() ||
                      (isAuthenticated() &&
                       resource.data.sellerEmail == myEmail() &&
                       request.resource.data.sellerEmail == resource.data.sellerEmail &&
                       request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    // Orders Collection — checkout supports guest (non-logged-in) buyers, so
    // creation must stay open, but the resulting records (names, emails,
    // phone numbers, addresses) are only readable by the buyer who placed the
    // order or an admin, and only an admin can change order status.
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() ||
                    (isAuthenticated() && resource.data.customerEmail == myEmail());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications Collection — created by the app for buyers/sellers/admins,
    // including during guest checkout, so creation stays open. Reading/marking
    // read is limited to the recipient or an admin.
    match /notifications/{notificationId} {
      allow create: if true;
      allow read, update: if isAdmin() ||
                            (isAuthenticated() && resource.data.recipientEmail == myEmail());
      allow delete: if isAdmin();
    }

    // Admin-only collections
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Non-sensitive site settings (auto-approve flag, welcome message) are
    // read by the seller dashboard, so keep read public; only admins can write.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
